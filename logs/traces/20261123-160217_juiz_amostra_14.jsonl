.suficiencia": "insuficiente", "nutri.saida.resultado": "N\u00e3o encontrei nas minhas fontes (TBCA e fichas da OMS) a informa\u00e7\u00e3o para responder isso. Consigo informar a composi\u00e7\u00e3o de alimentos como abacate, abobrinha, ab\u00f3bora, alho, amendoim, amido de milho, arroz, aveia, azeitona, a\u00e7\u00facar mascavo, banana, batata, e as recomenda\u00e7\u00f5es da OMS sobre alimenta\u00e7\u00e3o saud\u00e1vel e s\u00f3dio. Para outros alimentos, consulte um nutricionista.", "nutri.fontes": [], "nutri.contexto.recuperado": ["oms:oms-alimentacao-saudavel-2026#17", "oms:oms-alimentacao-saudavel-2026#16", "oms:oms-alimentacao-saudavel-2026#14", "tbca:BRC0064C", "tbca:BRC0054K"], "nutri.contexto.descartado": [], "nutri.escolhas": ["resposta do modelo descartada: o verificador n\u00e3o achou nas fontes o assunto da pergunta (Chocolate meio amargo e ma\u00e7\u00e3)"], "nutri.rodadas": 0, "nutri.uso.tokens": 8253, "nutri.uso.chamadas": 6, "nutri.uso.segundos_modelo": 76.06}, "events": [], "links": [], "resource": {"attributes": {"telemetry.sdk.language": "python", "telemetry.sdk.name": "opentelemetry", "telemetry.sdk.version": "1.45.2", "service.instance.id": "5de1c829-b7c3-430e-88b5-bd850b630b12", "service.name": "agente-nutricionista", "service.version": "1.1.0"}, "schema_url": ""}}
