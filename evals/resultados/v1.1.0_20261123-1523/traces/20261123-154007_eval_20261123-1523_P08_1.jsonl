: "insuficiente", "nutri.saida.resultado": "N\u00e3o encontrei 'quinoa' na tabela de composi\u00e7\u00e3o que eu uso (um recorte da TBCA). Consigo informar a composi\u00e7\u00e3o de alimentos como abacate, abobrinha, ab\u00f3bora, alho, amendoim, amido de milho, arroz, aveia, azeitona, a\u00e7\u00facar mascavo, banana, batata, e as recomenda\u00e7\u00f5es da OMS sobre alimenta\u00e7\u00e3o saud\u00e1vel e s\u00f3dio. Para outros alimentos, consulte um nutricionista.", "nutri.fontes": [], "nutri.contexto.recuperado": ["oms:oms-alimentacao-saudavel-2026#08", "oms:oms-alimentacao-saudavel-2026#03", "oms:oms-alimentacao-saudavel-2026#06"], "nutri.contexto.descartado": [], "nutri.escolhas": ["resposta do modelo descartada: n\u00famero(s) 14 n\u00e3o aparece(m) em nenhuma fonte consultada"], "nutri.rodadas": 0, "nutri.uso.tokens": 6254, "nutri.uso.chamadas": 5, "nutri.uso.segundos_modelo": 103.54}, "events": [], "links": [], "resource": {"attributes": {"telemetry.sdk.language": "python", "telemetry.sdk.name": "opentelemetry", "telemetry.sdk.version": "1.45.2", "service.instance.id": "3d1a3ef3-bc4b-459f-b6d2-3510efc1612b", "service.name": "agente-nutricionista", "service.version": "1.1.0"}, "schema_url": ""}}
