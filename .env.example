# Copie para .env e preencha. Nenhum valor aqui, de propósito.
# Sem .env, o sistema usa os padrões de src/config.py (Ollama local).

# Endpoint compatível com OpenAI (Ollama local: http://localhost:11434/v1)
LLM_BASE_URL=
# O Ollama ignora a chave, mas a biblioteca openai exige uma string não vazia
LLM_API_KEY=
# Modelo de chat (criado a partir do Modelfile: nutri-qwen)
LLM_MODELO=
# Modelo de embedding (bge-m3)
EMBED_MODELO=
# Prazo, em segundos, para a pessoa responder a uma pausa de aprovação (padrão: 86400)
PRAZO_APROVACAO_S=
# 0 desliga o desempate de versões da OMS por data (só para a demonstração do documento revogado)
DESEMPATE_OMS=
